generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  fullName    String
  honorific   String    @default("")
  role        String // OWNER | GM | ADMIN | EXEC | ACC | PM | HC | SK | SALES | CASHIER | MERCH
  title       String    @default("")
  phone       String?
  mobile      String? // شمارهٔ موبایل ترجیحی برای پیامک‌های کاری — 09xxxxxxxxx
  address     String?
  postalCode  String? // کد پستی ۱۰ رقمی ایران
  avatarJson  String? // {"emoji":"👑","color":"#0e7a4a"}
  pin         String? // 4-digit plain (initial 1234) — dual auth: pin OR password
  password    String? // admin password
  points      Int       @default(0)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

model RealtimeTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ============ CHECKLISTS / SOP / TASKS ============

model ChecklistTemplate {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  phase       String  @default("start") // start | middle | end
  frequency   String  @default("DAILY") // DAILY | WEEKLY | MONTHLY
  points      Int     @default(1)
  roleKey     String? // limit to role
  itemsJson   String  @default("[]") // [{text,hint}]
  order       Int     @default(0)
  active      Boolean @default(true)
}

model ChecklistState {
  id          String    @id @default(cuid())
  day         String // Jalali YYYY-MM-DD
  templateId  String
  itemsJson   String    @default("[]") // [{text,hint,done,note}]
  userId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([day, templateId])
}

model Sop {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  stepsJson   String   @default("[]") // [{title, detail?}]
  views       Int      @default(0)
  completions Int      @default(0) // R5-P4: شمارندهٔ اجرای کامل روال (پایان «شروع روال»)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id             String    @id @default(cuid())
  title          String
  detail         String?
  assignedToId   String?
  assignedToName String?
  createdById    String?
  createdByName  String?
  dueDate        String? // Jalali
  status         String    @default("open") // open | done
  points         Int       @default(1)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ============ COLLABORATION ============

model Message {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Broadcast {
  id         String   @id @default(cuid())
  fromId     String
  content    String
  attachment String?
  seenJson   String   @default("[]") // [userId]
  createdAt  DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  kind      String   @default("ANON") // ANON | IDEA
  authorId  String?
  content   String
  status    String   @default("NEW") // NEW | REVIEWED | IMPLEMENTED
  response  String?
  points    Int      @default(0)
  createdAt DateTime @default(now())
}

model Problem {
  id          String    @id @default(cuid())
  date        String // Jalali
  problem     String
  action      String?
  responsible String?
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  reporterId  String?
  shift       String    @default("MORNING") // MORNING | EVENING
  time        String? // HH:MM ساعت وقوع
  source      String    @default("STAFF") // STAFF | MANAGER | GM
  escalated   Boolean   @default(false) // ارجاع به شیفت عصر
  // v0.3 (B1): دسته‌بندی، شدت، مکان، مسئول پیگیری، مهلت و زمان حل
  category    String    @default("other") // equipment | it | supply | cleaning | product | staff | customer | security | other
  severity    String    @default("normal") // low | normal | high | urgent
  location    String? // برچسب بلوک نقشه فروشگاه
  assigneeId  String? // User.id مسئول پیگیری
  dueDate     String? // Jalali YYYY-MM-DD
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model ShiftReport {
  id               String    @id @default(cuid())
  userId           String
  date             String // Jalali
  type             String // HANDOVER | MORNING | WEEKLY | MONTHLY_EVAL
  dataJson         String // {cashCounted, cashExpected, ..., metrics} | legacy notepad JSON
  note             String?
  shift            String    @default("MORNING") // MORNING | EVENING
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())
}

model WallPost {
  id        String   @id @default(cuid())
  content   String
  pinned    Boolean  @default(false)
  authorId  String
  likesJson String? // [userId]
  createdAt DateTime @default(now())
}

model KbArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String   @default("")
  body      String   @default("")
  imageUrl  String?
  pinned    Boolean  @default(false)
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Award {
  id            String   @id @default(cuid())
  userId        String
  points        Int
  reason        String
  awardedById   String?
  awardedByName String?
  createdAt     DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  role      String?
  kind      String // message | return | cheque | ...
  severity  String    @default("info") // info | warning | critical
  title     String
  body      String
  go        String? // hash route
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String
  actionLabel String?
  category    String   @default("general")
  detail      String?
  entityId    String?
  createdAt   DateTime @default(now())
}

// ============ PRODUCTS & SUPPLIERS ============

model Product {
  id                String   @id @default(cuid())
  name              String
  code              String? // Holoo code / main barcode
  unit              String   @default("عدد")
  manualUnit        Boolean  @default(false) // R4-8: true = واحد دستی مدیر؛ موتور قاعده لمس نمی‌کند
  category          String?
  mainGroup         String?
  subGroup          String?
  barcodesJson      String   @default("[]")
  sellPrice         Float    @default(0)
  sellPrice2        Float    @default(0)
  lastBuyPrice      Float    @default(0)
  stock             Int      @default(0)
  reorderLevel      Int?
  shelfLifeDays     Int?
  status            String   @default("فعال")
  active            Boolean  @default(true)
  sectionLabel      String? // R5-P4: بخش/قفسهٔ فروشگاه (برچسب بلوک نقشه) که کالا در آن چیده می‌شود
  // v0.2: سفارش‌گذاری و هوشمندسازی
  defaultOrderQty   Int      @default(6) // تعداد پیش‌فرض سفارش (عدد)
  defaultCartonQty  Int      @default(1) // تعداد پیش‌فرض سفارش (کارتن)
  unitsPerCarton    Int      @default(0) // تعداد در هر کارتن (0 = نامشخص)
  lowStockThreshold Int? // حد سفارش مجدد اختصاصی
  smsAlert          Boolean  @default(false) // اطلاع SMS به مدیران هنگام اتمام
  leadTimeDays      Int      @default(1) // زمان تأمین تأمین‌کننده
  imported          Boolean  @default(false) // کالای وارداتی (تقویم میلادی برای تاریخ‌ها)
  holooErp          String? // شناسه ErpCode کالا در هلو (سینک دوطرفه)
  monthlySold       Int      @default(0) // آمار فروش ماه اخیر (برای تحلیل)
  lastCountDate     String? // Jalali آخرین انبارگردانی
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  key       String   @unique // barcode or product id key
  url       String
  bytes     Int      @default(0)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  code           String?
  phone          String?
  job            String?
  classification String? // شهر / دسته
  intermediary   String?
  balance        Float?
  creditLimit    Float    @default(0)
  holooErp       String? // شناسه ErpCode طرف حساب در هلو
  status         String   @default("فعال")
  note           String?
  createdAt      DateTime @default(now())
}

// ============ ORDERS ============

model Order {
  id            String    @id @default(cuid())
  code          String    @unique // HZ-ORD-001
  status        String    @default("SUBMITTED") // SUBMITTED | APPROVED | RECEIVING | RECEIVED | VERIFIED | DONE | CANCELLED
  supplierId    String?
  supplierName  String?
  deliveryDate  String? // Jalali
  payMethod     String    @default("CASH") // CASH | CHEQUE | POS
  chequeDays    Int       @default(0) // R8: سررسید چک این سفارش (روز) — هنگام پایان دریافت، چک با این سررسید خودکار ثبت می‌شود
  notes         String?
  totalAmount   Float     @default(0)
  createdById   String?
  createdByName String?
  holooErp      String? // شناسه ErpCode سفارش خرید ثبت‌شده در هلو
  receivedAt    DateTime?
  // ── R14: تأیید مدیر کل (خانم لطفی) پس از ثبت حسابداری — پیش از بستن سفارش؛
  //    هم‌زمان قیمت‌های فاکتور سودسنجِ متصل منتشر می‌شود
  gmApprovedAt    DateTime?
  gmApprovedById  String?
  gmApprovedByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items OrderItem[]
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String?
  name              String
  barcode           String?
  qty               Int     @default(1)
  unitBuyPrice      Float   @default(0)
  printedPrice      Float   @default(0)
  receivedQty       Int?
  returnedQty       Int     @default(0) // R8: تعداد مرجوعی جزئی همین قلم (مثلاً ۴ از ۱۲)
  returnReason      String? // R8: علت مرجوعی (شکسته · قیمت چاپی متفاوت · تاریخ‌گذشته · …)
  status            String  @default("PENDING") // PENDING | OK | MISSING | REJECTED | PARTIAL_RETURN | RETURNED
  expiryDate        String?
  note              String?
  // v0.2: سفارش بر اساس کارتن
  cartonQty         Int     @default(0) // تعداد کارتن (0 = سفارش تکی)
  unitsPerCarton    Int     @default(0) // تعداد در کارتن
  lineTotal         Float   @default(0) // برآورد هزینه سطر
  supplierProductId String? // انتخاب تأمین‌کننده مشخص برای این کالا

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============ RETURNS ============

model ReturnRequest {
  id                 String    @id @default(cuid())
  code               String    @unique // HZ-050723-0001
  customerName       String?
  customerPhone      String?
  customerCardNumber String?
  purchaseAt         String? // Jalali
  reason             String?
  note               String?
  totalAmount        Float     @default(0)
  exchangeValue      Float     @default(0)
  transferAmount     Float     @default(0)
  transferNote       String?
  settlementType     String    @default("exchange") // exchange | transfer | both
  status             String    @default("draft") // draft | pending | approved | paid
  cashierId          String?
  approvedById       String?
  approvedAt         DateTime?
  submittedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  items ReturnItem[]
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  name      String
  barcode   String?
  qty       Float   @default(1) // R7: مقدار اعشاری برای کالایbulk (مثلاً ۰٫۷۲ کیلوگرم بادام زمینی)
  unit      String  @default("عدد")
  unitPrice Float   @default(0)
  lineTotal Float   @default(0)

  ret ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model ReturnPayment {
  id        String   @id @default(cuid())
  returnId  String
  kind      String // TRANSFER | ...
  amount    Int
  note      String?
  createdAt DateTime @default(now())
}

/// الگوی پیام مرجوعی — پیام آمادهٔ مشتری بر اساس علت مرجوعی (R10-MSG)
/// reason: یکی از REASON_PRESETS (کالای معیوب، …) یا «*» برای پیش‌فرض کلی
model ReturnMsgTemplate {
  id        String   @id @default(cuid())
  reason    String   @unique // علت مرجوعی (دقیقاً مثل REASON_PRESETS) یا «*» برای پیش‌فرض کلی
  title     String
  body      String   // با جای‌نگردها: {مشتری} {مبلغ} {کد} {تاریخ} {علت} {بانک} {شماره‌پیگیری}
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ CRM ============

model Customer {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  returnsCount Int      @default(0)
  totalAmount  Float    @default(0)
  firstAt      DateTime @default(now())
  lastVisitAt  DateTime @default(now())
  smsEnabled   Boolean  @default(true)
  birthday     String? // Jalali
  note         String?
  manualTier   String? // VIP | LOYAL | REGULAR | NEW | AT_RISK | DORMANT
}

model Campaign {
  id         String   @id @default(cuid())
  title      String
  kind       String   @default("WINBACK") // WINBACK | BIRTHDAY | SEASONAL | ...
  targetTier String?
  date       String? // Jalali
  status     String   @default("DRAFT") // DRAFT | SENT
  createdAt  DateTime @default(now())
}

model CrmEvent {
  id         String   @id @default(cuid())
  customerId String?
  kind       String // sms | note | call | visit
  content    String
  userId     String?
  createdAt  DateTime @default(now())
}

// ============ FINANCE ============

model Cheque {
  id          String   @id @default(cuid())
  number      String
  amount      Float    @default(0)
  status      String   @default("PENDING_OWNER") // PENDING_OWNER | WRITTEN | SIGNED | READY | COLLECTED | DONE | REJECTED | UNCOLLECTED
  recipient   String?
  sayadSerial String?
  selfIssued  Boolean  @default(false)
  writtenAt   String? // Jalali
  dueDate     String // Jalali
  note        String?
  orderCode   String?
  orderId     String? // R8: سفارشی که این چک برایش خودکار ثبت شد
  historyJson String   @default("[]") // [{at, by, action, detail}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id             String   @id @default(cuid())
  kind           String // CASH | POS | TRANSFER
  amount         Float    @default(0)
  supplierName   String?
  orderCode      String?
  note           String?
  holooReceiptNo String?
  createdById    String?
  createdBy      String?
  createdAt      DateTime @default(now())
}

// ============ MARGIN (سودسنج) ============

model MarginInvoice {
  id                String    @id @default(cuid())
  number            Int       @default(1)
  supplierId        String?
  supplierName      String?
  note              String?
  // R12 گردش‌کار دفتر فاکتورها: draft (پیش‌نویس) | delivered (تحویل‌شده) |
  // reviewing (در بررسی حسابداری) | final (فاکتور خرید) | archived (بایگانی‌شده) | cancelled
  status            String    @default("draft")
  archived          Boolean   @default(false)
  archivedAt        DateTime?
  dateJalali        String?
  // R5-B: شمارهٔ سند کاغذی تأمین‌کننده (شمارهٔ داخلی همان number خودکار است)
  providerDocNumber String?
  // R5-B: شناسهٔ سفارش خرید (Order) که از «ثبت تحویل و خرید» ساخته شده
  purchaseOrderId   String?
  // ── R12: ردپای گردش‌کار چندمرحله‌ای پیش‌فاکتور → فاکتور خرید → بایگانی ──
  deliveredAt       DateTime? // گام ۲: کارمند، تحویل فیزیکی را تأیید کرد
  deliveredById     String?
  deliveredByName   String?
  reviewedAt        DateTime? // گام ۳: حسابدار/مدیر بررسی را شروع/انجام داد
  reviewedById      String?
  reviewedByName    String?
  finalizedAt       DateTime? // گام ۴: فاکتور خرید نهایی شد (سند خرید + موجودی + هلو)
  finalizedById     String?
  finalizedByName   String?
  // ── R13: گام ۵ — تأیید نهایی مدیرعامل (خانم لطفی) پیش از بایگانی؛
  //    هم‌زمان قیمت نهایی (sellPrice) و قیمت چاپی (sellPrice2 = SellPrice2 هلو)
  //    روی کالا به‌روز و در هلو منتشر می‌شود.
  gmApprovedAt      DateTime?
  gmApprovedById    String?
  gmApprovedByName  String?
  cancelledAt       DateTime?
  cancelledByName   String?
  cancelReason      String?
  holooInvoiceNo    String? // شماره فاکتور خرید هلو (پس از انتقال/ثبت)
  holooReceiptNo    String? // شماره رسید پرداخت هلو
  archiveDocId      String? // سند بایگانی (ArchiveDocument) ساخته‌شده از این فاکتور
  historyJson       String    @default("[]") // [{at,by,action,detail}] ردپای گردش‌کار
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items MarginItem[]
}

model MarginItem {
  id            String  @id @default(cuid())
  invoiceId     String
  productId     String?
  barcode       String?
  productName   String
  unit          String  @default("عدد")
  quantity      Float   @default(1) // R5-B: اعشاری برای اقلام وزنی (۱٫۵ کیلو)
  totalCost     Float   @default(0)
  unitCost      Float   @default(0)
  printedPrice  Float   @default(0)
  margin        Float   @default(0)
  profitPerUnit Float   @default(0)
  note          String?
  level         String  @default("OK") // OK | WARN | CRITICAL
  alertsJson    String  @default("[]")
  // ─── R5-B: بازطراحی سودسنج ───
  salePrice     Float   @default(0) // قیمت فروش نهایی (۰ = همان قیمت چاپی — سازگار با ردیف‌های قدیمی)
  marginPct     Float   @default(0) // درصد سود ۴ رقمی روی بهای خرید (همان عددی که حسابدار می‌بیند)
  free100       Boolean @default(false) // تخفیف ۱۰۰٪ / رایگان — بدون قیمت چاپی
  baseCost      Float   @default(0) // مبنای محاسبهٔ فروش کالای رایگان (قیمت عادی تأمین‌کننده)
  // ─── R12: بررسی حسابداری — پذیرش/رد هر قلم (مرجوعی به تأمین‌کننده) ───
  accepted      Boolean @default(true) // مورد تأیید حسابداری (وارد انبار/هلو می‌شود)
  rejectReason  String? // علت مرجوعی: قیمت چاپی متفاوت · تاریخ‌گذشته · شکسته · …

  invoice MarginInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ============ HR ============

model Personnel {
  id             String  @id @default(cuid())
  userId         String  @unique
  fullName       String
  nationalId     String?
  phone          String?
  jobTitle       String?
  department     String?
  hireDate       String? // Jalali
  birthday       String? // Jalali
  bankCard       String?
  shaba          String?
  emergencyName  String?
  emergencyPhone String?
  note           String?
  // قرارداد کار — قابل ویرایش توسط مدیران (R4-6)
  contractType   String? // FULL_TIME | PART_TIME | CONTRACT
  contractStart  String? // Jalali
  contractEnd    String? // Jalali
  contractSalary Float?
  contractNote   String?
  active         Boolean @default(true)
}

/// مدارک قانونی پرسنل — کارت ملی/شناسنامه/قرارداد/عکس/مدرک/فیش (R4-6)
model StaffDocument {
  id         String   @id @default(cuid())
  userId     String // staff User id
  kind       String // NATIONAL_CARD | ID_BOOK | CONTRACT | PHOTO | CERT | PAYSLIP | OTHER
  title      String   @default("")
  mimeType   String   @default("image/jpeg")
  size       Int      @default(0)
  dataUrl    String // base64 data URL (cap 2.5MB server-side)
  note       String   @default("")
  uploadedBy String   @default("")
  createdAt  DateTime @default(now())
}

model SalaryProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  baseSalary       Float    @default(0)
  housingAllowance Float    @default(0)
  foodAllowance    Float    @default(0)
  childAllowance   Float    @default(0)
  children         Int      @default(0)
  seniorityDaily   Float    @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  userId    String
  date      String // Jalali
  shift     String // MORNING | EVENING | NIGHT | OFF
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  type         String // HOURLY | DAILY | SICK | UNPAID
  fromDate     String // Jalali
  toDate       String // Jalali
  days         Int      @default(1)
  hours        Float    @default(0) // مرخصی ساعتی — کسری ساعت (۲٫۵) پشتیبانی می‌شود (R5-C)
  reason       String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  responseNote String?
  approverId   String?
  approverName String?
  createdAt    DateTime @default(now())
}

