  @@unique([date, shift, staffId])
}

/// ارزیابی چیدمان هر خط/قفسه — ۴ شاخص علمی (تاریخ‌ها/FEFO، نظم چیدمان، نظافت، برچسب‌ها)
model SectionReview {
  id           String   @id @default(cuid())
  date         String // Jalali
  reviewerId   String
  reviewerName String
  blockLabel   String // G1 | IC-A | NUTS | SWEETS | FRZ | W-L1 …
  staffId      String? // مسئول آن خط
  staffName    String?
  dateScore    Int      @default(0) // 0-5 کنترل تولید/انقضا و چیدمان FEFO
  layoutScore  Int      @default(0) // 0-5 نظم و مرتب بودن چیدمان
  cleanScore   Int      @default(0) // 0-5 نظافت خط، قفسه‌ها، کف وعدم گرد روی کالا
  labelScore   Int      @default(0) // 0-5 برچسب و قیمت در برابر هر ردیف
  /* R15: انقضا به «کنترل انقضای قفسه‌ها» (lane-check) رفت؛ به‌جایش دو شاخص عملکردی:
     dateScore اکنون «شارژ و کامل بودن قفسه» را می‌سنجد (نام ستون حفظ شد) + serveScore جدید */
  serveScore   Int      @default(0) // 0-5 برخورد و پاسخگویی به مشتری (R15)
  note         String?
  points       Int      @default(0) // امتیاز اهدایی
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// امتیاز ترکیبی عملکرد کارکنان (روش علمی: ترکیب وزن‌دار چندشاخصه)
model PerformanceScore {
  id              String   @id @default(cuid())
  userId          String
  userName        String
  periodType      String // WEEKLY | MONTHLY
  periodKey       String // 1405-07 or 1405-W30
  startDate       String // Jalali
  endDate         String // Jalali
  taskScore       Float    @default(0) // 0-100: نرخ تکمیل دستور کار به‌موقع
  sectionScore    Float    @default(0) // 0-100: میانگین ۴ شاخص ارزیابی چیدمان
  dailyCheckScore Float    @default(0) // 0-100: میانگین بازرسی روزانهٔ ۴ معیار (ok=1, minor=0.5, needs_followup=0) — R7-PERF
  checklistScore  Float    @default(0) // 0-100: تکمیل چک‌لیست‌ها
  attendanceScore Float    @default(0) // 0-100: حضور و تعجیل
  zoneCountScore  Float    @default(0) // 0-100: دقت شمارش
  extraScore      Float    @default(0) // امتیاز تشویقی − جریمه
  total           Float    @default(0) // 0-100 ترکیب وزن‌دار
  grade           String   @default("") // A | B | C | D
  breakdownJson   String   @default("{}") // جزئیات محاسبه برای شفافیت
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, periodType, periodKey])
}

/// ارزیابی ماهانه مدیر شیفت توسط مدیر ارشد (۱۱ شاخص شرح وظایف)
model ManagerReview {
  id           String   @id @default(cuid())
