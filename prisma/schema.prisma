  nearExpiryCount Int      @default(0)
  fefoOk          Boolean  @default(true) // 临期 در جلو (FEFO)
  action          String? // اقدام انجام‌شده
  note            String?
  columnsJson     String? // [{name,status,expiredCount,note}] — ستون‌های کنترل‌شده این چرخش (B3)
  createdAt       DateTime @default(now())

  @@unique([date, lineId])
