/// کنترل پرسنل شیفت عصر/صبح — حضور، تأخیر، بهداشت个体
model StaffCheck {
  id                 String   @id @default(cuid())
  date               String // Jalali YYYY-MM-DD
  shift              String   @default("EVENING") // MORNING | EVENING
  checkerId          String
  checkerName        String
  staffId            String // User.id
  staffName          String
  present            Boolean  @default(true)
  arrival            String   @default("on_time") // on_time | late | absent | permitted_leave
  lateMinutes        Int      @default(0)
  hourlyLeaveMinutes Int      @default(0) // مرخصی ساعتی (دقیقه)
  overtimeMinutes    Int      @default(0) // اضافه‌کاری (دقیقه)
  hadPermission      Boolean  @default(false) // اجازه تأخیر از مدیر
  uniform            String   @default("ok") // ok | minor | needs_followup (لباس فرم و ظاهر — سه‌سطحی R7)
  hygiene            String   @default("ok") // ok | minor | needs_followup (بهداشت فردی — سه‌سطحی R7)
  behavior           String   @default("ok") // ok | minor | needs_followup (برخورد با مشتری — سه‌سطحی R7)
  workQuality        String   @default("ok") // ok | minor | needs_followup (کیفیت کار — سه‌سطحی R7)
