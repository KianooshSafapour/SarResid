  blockLabel   String? // خط/بخش
  zoneName     String?
  staffId      String?
  staffName    String?
  status       String           @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | DONE | MISMATCH
  itemsCounted Int              @default(0)
  mismatches   Int              @default(0)
