  blocks FloorBlock[]
}

/// ردیف‌های چیدمان هر بخش (نام مدل تاریخی: ZoneColumn) برای کنترل تاریخ چرخشی (B3)
/// R5-E: ردیف = ردیف کالا روی قفسه — دارای محصولات و ظرفیت و وضعیت شارژ
model ZoneColumn {
  id           String   @id @default(cuid())
  planId       String
  blockLabel   String
  name         String
  order        Int      @default(0)
  active       Boolean  @default(true)
  productsJson String   @default("[]") // [{productId,name,capacity}] — محتوای ردیف (R5-E)
  statusJson   String   @default("{}") // {lastCharge:{count,at,by},lastCount:{count,at,by},minCount} (R5-E)
  createdAt    DateTime @default(now())

  @@unique([planId, blockLabel, name])
}

model FloorBlock {
  id       String  @id @default(cuid())
  planId   String
  kind     String // ENTRANCE | EXIT | CHECKOUT | SHELF | WALL | COOLER | ...
  x        Int
  y        Int
  w        Int
  h        Int
  rotation Int     @default(0)
  label    String?
  zoneName String?
  metaJson String? // {responsible, ...}

  plan Floorplan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Planogram {
  id         String   @id @default(cuid())
  name       String
  blockLabel String?
  rows       Int      @default(4)
  cols       Int      @default(6)
  cellsJson  String   @default("[]") // flat array rows*cols of productId|null
  status     String   @default("DRAFT") // DRAFT | PUBLISHED | DONE | ARCHIVE
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Zone {
  id             String  @id @default(cuid())
  name           String
  type           String  @default("SALES") // SALES | BACKROOM | COLD | ...
  criticality    String  @default("C") // A | B | C
  countFrequency String  @default("MONTHLY") // DAILY | WEEKLY | MONTHLY
  ownerName      String?
  minStaff       Int?
}

model ZoneCount {
  id            String   @id @default(cuid())
  date          String // Jalali
  zoneId        String
  zoneName      String
  userId        String?
  userName      String?
  itemsJson     String   @default("[]") // [{name|barcode, expected, counted}]
  status        String   @default("open") // open | done
  mismatchCount Int      @default(0)
  totalItems    Int      @default(0)
  tolerance     Float    @default(0)
  recheckCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PriceCheck {
  id        String   @id @default(cuid())
  date      String // Jalali
  productId String
  userId    String?
  lastCost  Int      @default(0)
  sellPrice Float    @default(0)
  margin    Float    @default(0)
  ok        Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

model WasteRecord {
  id        String   @id @default(cuid())
  date      String // Jalali
  name      String
  qty       Int      @default(1)
  unit      String   @default("عدد")
  reason    String // EXPIRED | DAMAGED | LOST | ...
  estValue  Float    @default(0)
  userId    String?
  userName  String?
  note      String?
  createdAt DateTime @default(now())

  // ── R9: ضایعات به تفکیک طرف‌حساب (تأمین‌کننده) — برگشت با سفارش بعدی ──
  // گردش کار: PENDING (در انبار ضایعاتِ تأمین‌کننده) → SELECTED (خانم لطفی برای سفارش بعدی علامت می‌زند)
  // → RETURNED (هنگام پایان دریافت سفارش، همراه مامور پخش به تأمین‌کننده برگشت)
  supplierId       String?
  supplierName     String?
  productId        String?
  barcode          String?
  status           String   @default("PENDING") // PENDING | SELECTED | RETURNED
  orderId          String?
  orderCode        String?
  selectedAtJalali String?
  selectedByName   String?
  returnedAtJalali String?

  // ── R11: مامور پخش (نمایندهٔ تأمین‌کننده) که اقلام ضایعات به او سپرده شد —
  // هنگام «پایان دریافت» اجباری ثبت می‌شود (نام کامل + موبایل)
  repName  String?
  repPhone String?
}

