  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// کنترل تاریخ انقضا — ثبت نتیجه بررسی خط‌ها در چرخه ۲۸ روزه (سیستم شماره‌گذاری خطوط)
model DateCheck {
  id              String   @id @default(cuid())
  date            String // Jalali YYYY-MM-DD
  lineId          String // LINE-07
  lineLabel       String // «گوندولا ۲ — روی شرقی»
  blockLabel      String
  daySlot         Int      @default(0) // روز چرخه (۱..۲۸)
  checkerId       String
  checkerName     String
  status          String   @default("ok") // ok | issues
