/// نسخه پشتیبان داده‌ها — «بازنشانی به آخرین وضعیت داده» (R4-7)
model DataSnapshot {
  id         String   @id @default(cuid())
  name       String
  note       String   @default("")
  kind       String   @default("MANUAL") // MANUAL | BASELINE | PRE_IMPORT
  tablesJson String   @default("{}") // per-table row dumps
  tableCount Int      @default(0)
  rowCount   Int      @default(0)
  createdBy  String   @default("")
  createdAt  DateTime @default(now())
}

// ===================== R7 EXTENSIONS (پوسته — v_0.1.1_alpha) =====================

/// مدیریت واحدهای شمارش — مدیر می‌تواند واحد جدید بسازد (R7)
model Unit {
  id        String   @id @default(cuid())
  name      String   @unique // عدد · کیلوگرم · بسته …
  kind      String   @default("count") // count (صحیح) | weight (اعشاری) | volume (اعشاری)
  decimals  Int      @default(0) // حداکثر ارقام اعشار مجاز
  active    Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== R7 — آرشیو اسناد (مدیریت اسناد هیبریدی دیجیتال/فیزیکی) =====================

/// کابینت فیزیکی آرشیو
model ArchiveCabinet {
  id        String   @id @default(cuid())
  name      String // «کابینت حسابداری ۱»
  code      String   @unique // CAB-01
  location  String? // محل فیزیکی (دفتر حسابداری …)
  note      String?
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelves ArchiveShelf[]
}

/// قفسهٔ داخل کابینت
model ArchiveShelf {
  id        String   @id @default(cuid())
  cabinetId String
  name      String // «قفسهٔ ۲»
  code      String   @unique // CAB-01-S2
  note      String?
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet ArchiveCabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  binders ArchiveBinder[]
}

/// زون‌بند (ledger binder) داخل قفسه
model ArchiveBinder {
  id        String   @id @default(cuid())
  shelfId   String
  name      String // «زون‌بند لبنیات»
  code      String   @unique // CAB-01-S2-B1
  category  String? // دسته‌بندی محتوا (لبنیات · شیرینی · وارداتی …)
  color     String? // رنگ زون‌بند فیزیکی
  note      String?
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelf     ArchiveShelf      @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  documents ArchiveDocument[]
}

/// نمایندهٔ فروش / رانندهٔ تأمین‌کننده — افراد بیرونی که با آن‌ها سر و کار داریم
model SalesRep {
  id        String   @id @default(cuid())
  name      String
  mobile    String?
  company   String? // شرکت / تأمین‌کنندهٔ مربوطه (متن آزاد — برای سازگاری با گذشته)
  title     String? // سمت (نماینده · راننده …)
  note      String?
  active    Boolean  @default(true)
  supplierIdsJson String? // R10: آرایهٔ JSON شناسهٔ تأمین‌کننده‌هایی که این نماینده برایشان کار می‌کند
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// سند آرشیو — رکورد دیجیتالِ هر مدرک فیزیکی (فاکتور خرید · رسید پرداخت · چک · مرجوعی · سفارش …)
model ArchiveDocument {
  id             String   @id @default(cuid())
  kind           String   @default("ORDER") // ORDER | INVOICE | RECEIPT | CHEQUE | RETURN | OTHER
  title          String
  dateJalali     String? // تاریخ سند YYYY-MM-DD
  // ارتباط با موجودیت‌های سامانه (loosely coupled — فقط شناسه/نام، بدون FK سخت)
  supplierId     String?
  supplierName   String?
  orderId        String?
  orderCode      String?
  returnId       String?
  returnCode     String?
  chequeId       String?
  chequeNumber   String?
  // شماره‌های هلو
  holooInvoiceNo String? // شماره فاکتور خرید هلو
  holooReceiptNo String? // شماره رسید پرداخت هلو
  // نمایندهٔ بیرونی
  repId          String?
  repName        String?
  repRole        String? // دریافت چک · دریافت نقدی · تحویل مرجوعی · کالای نیامده …
  repNote        String?
  // محل فیزیکی سند
  binderId       String?
  folio          String? // شمارهٔ صفحه/جیب داخل زون‌بند
  // R8: اسکن دیجیتال سند (data-URL تصویر — مثل لوگوی برند، حداکثر ~۳۰۰KB)
  scanDataUrl    String?
  scanName       String? // نام فایل اصلی اسکن
  // مبالغ و وضعیت
  amount         Float    @default(0)
  status         String   @default("ARCHIVED") // PENDING | IN_PROGRESS | ARCHIVED | MISSING
  returnedJson   String   @default("[]") // اقلام مرجوعی [{name, qty, reason}] — در قرمز نمایش داده می‌شود
  note           String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  binder ArchiveBinder? @relation(fields: [binderId], references: [id], onDelete: SetNull)
}

// ===================== R7 — تاریخچهٔ خرید و فروش (دادهٔ واقعی هلو) =====================

/// رکورد خرید/فروش ماهانه از خروجی هلو (تیر تا مهر ۱۴۰۵) — مبنای نمودارهای عملکرد کالا
model TradeRecord {
  id          String   @id @default(cuid())
  kind        String // BUY | SELL
  month       String // 1405-04 (تیر)
  dateJalali  String // 1405.04.01
  invoiceNo   String // شماره فاکتور هلو
  rowIdx      Int // ردیف در فایل مبدأ (کلید idempotency)
  productName String
  productId   String? // اتصال به Product (با بارکد/نام)
  barcode     String?
  qty         Float    @default(0)
  unitPrice   Float    @default(0)
  lineTotal   Float    @default(0)
  discount    Float    @default(0)
  totalAfter  Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([kind, month, invoiceNo, rowIdx])
}

// ===================== R8 — کنترل انقضای کالاها (روی ردیف/قفسه) =====================

/// بازرسی انقضا توسط چیدمان‌گر — مدیر انتخاب می‌کند کدام چیدمان‌گر، کدام بخش/ردیف را
/// بررسی کرده و سیستم آخرین وضعیت هر ردیف را نگه می‌دارد («هر ردیف کِی و چطور دیده شد»)
model LaneCheck {
  id               String   @id @default(cuid())
  dateJalali       String // YYYY-MM-DD روز بازرسی
  merchandiserId   String? // کاربر چیدمان‌گر (خانم لطفی / آقای ملایی و…)
  merchandiserName String
  sectionLabel     String // بخش فروشگاه (برچسب بلوک نقشه — G1 | IC-A | NUTS | …)
  lane             String // ردیف/طبقهٔ مشخص — «طبقهٔ ۲» | «قفسهٔ یخچال ۱» | «باتوم راست» …
  status           String   @default("ok") // ok | needs_attention | problem
  expiredFound     Int      @default(0) // تعداد اقلام تاریخ‌گذشتهٔ پیدا‌شده
  nearExpiry       Int      @default(0) // اقلام نزدیک انقضا (۳۰ روز)
  removedQty       Int      @default(0) // تعداد جمع‌آوری‌شده از قفسه
  note             String?
  createdById      String?
  createdByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sectionLabel, lane])
}

// ===================== R8 — زمان‌بندی انبارگردانی بر اساس کالا =====================

/// برنامهٔ شمارش دوره‌ای هر کالا — بعد از هر انبارگردانی، تاریخ بعدی بر اساس دورهٔ
/// عملی (بر پایهٔ گردش فروش) خودکار می‌نشیند؛ مدیر می‌تواند دوره‌ها را شخصی‌سازی کند
model CountSchedule {
  id              String   @id @default(cuid())
  productId       String
  productName     String
  barcode         String?
  intervalDays    Int      @default(30) // دورهٔ شمارش (روز) — 7/14/30/60/90/120/180
  lastCountJalali String? // آخرین بار کِی شمرده شد
  lastDiff        Int      @default(0) // آخرین مغایرت
  nextDueJalali   String // موعد بعدی
  active          Boolean  @default(true)
  autoReschedule  Boolean  @default(true) // بعد از هر شمارش، موعد بعدی خودکار جلو برود
  priority        String   @default("NORMAL") // HIGH | NORMAL | LOW (بر پایهٔ گردش فروش)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId])
}
