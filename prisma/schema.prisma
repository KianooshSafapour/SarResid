generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  fullName    String
  honorific   String    @default("")
  role        String // OWNER | GM | ADMIN | EXEC | ACC | PM | HC | SK | SALES | CASHIER | MERCH
  title       String    @default("")
  phone       String?
  avatarJson  String? // {"emoji":"👑","color":"#0e7a4a"}
  pin         String? // 4-digit plain (initial 1234) — dual auth: pin OR password
  password    String? // admin password
  points      Int       @default(0)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

model RealtimeTicket {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ============ CHECKLISTS / SOP / TASKS ============

model ChecklistTemplate {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  phase       String  @default("start") // start | middle | end
  frequency   String  @default("DAILY") // DAILY | WEEKLY | MONTHLY
  points      Int     @default(1)
  roleKey     String? // limit to role
  itemsJson   String  @default("[]") // [{text,hint}]
  order       Int     @default(0)
  active      Boolean @default(true)
}

model ChecklistState {
  id          String    @id @default(cuid())
  day         String // Jalali YYYY-MM-DD
  templateId  String
  itemsJson   String    @default("[]") // [{text,hint,done,note}]
  userId      String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([day, templateId])
}

model Sop {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  stepsJson   String   @default("[]") // [{title, detail?}]
  views       Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id           String    @id @default(cuid())
  title        String
  detail       String?
  assignedToId String?
  assignedToName String?
  createdById  String?
  createdByName String?
  dueDate      String? // Jalali
  status       String    @default("open") // open | done
  points       Int       @default(1)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
}

// ============ COLLABORATION ============

model Message {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Broadcast {
  id         String   @id @default(cuid())
  fromId     String
  content    String
  attachment String?
  seenJson   String   @default("[]") // [userId]
  createdAt  DateTime @default(now())
}

model Feedback {
  id        String    @id @default(cuid())
  kind      String    @default("ANON") // ANON | IDEA
  authorId  String?
  content   String
  status    String    @default("NEW") // NEW | REVIEWED | IMPLEMENTED
  response  String?
  points    Int       @default(0)
  createdAt DateTime  @default(now())
}

model Problem {
  id           String   @id @default(cuid())
  date         String // Jalali
  problem      String
  action       String?
  responsible  String?
  status       String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  reporterId   String?
  createdAt    DateTime @default(now())
}

model ShiftReport {
  id        String   @id @default(cuid())
  userId    String
  date      String // Jalali
  type      String // HANDOVER | MORNING
  dataJson  String // {absent, shortage, expiring, equipment, complaints, done, remaining, notes, ...}
  note      String?
  createdAt DateTime @default(now())
}

model WallPost {
  id        String   @id @default(cuid())
  content   String
  pinned    Boolean  @default(false)
  authorId  String
  likesJson String? // [userId]
  createdAt DateTime @default(now())
}

model KbArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String   @default("")
  body      String   @default("")
  imageUrl  String?
  pinned    Boolean  @default(false)
  views     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Award {
  id            String   @id @default(cuid())
  userId        String
  points        Int
  reason        String
  awardedById   String?
  awardedByName String?
  createdAt     DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  role      String?
  kind      String // message | return | cheque | ...
  severity  String    @default("info") // info | warning | critical
  title     String
  body      String
  go        String? // hash route
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String
  actionLabel String?
  category    String   @default("general")
  detail      String?
  entityId    String?
  createdAt   DateTime @default(now())
}

// ============ PRODUCTS & SUPPLIERS ============

model Product {
  id           String   @id @default(cuid())
  name         String
  code         String? // Holoo code / main barcode
  unit         String   @default("عدد")
  category     String?
  mainGroup    String?
  subGroup     String?
  barcodesJson String   @default("[]")
  sellPrice Float @default(0)
  sellPrice2 Float @default(0)
  lastBuyPrice Float @default(0)
  stock        Int      @default(0)
  reorderLevel Int?
  shelfLifeDays Int?
  status       String   @default("فعال")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  key       String   @unique // barcode or product id key
  url       String
  bytes     Int      @default(0)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  code           String?
  phone          String?
  job            String?
  classification String? // شهر / دسته
  intermediary   String?
  balance        Int?
  creditLimit Float @default(0)
  status         String   @default("فعال")
  note           String?
  createdAt      DateTime @default(now())
}

// ============ ORDERS ============

model Order {
  id           String    @id @default(cuid())
  code         String    @unique // HZ-ORD-001
  status       String    @default("SUBMITTED") // SUBMITTED | APPROVED | RECEIVING | RECEIVED | VERIFIED | DONE | CANCELLED
  supplierId   String?
  supplierName String?
  deliveryDate String? // Jalali
  payMethod    String    @default("CASH") // CASH | CHEQUE | POS
  notes        String?
  totalAmount Float @default(0)
  createdById  String?
  createdByName String?
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items OrderItem[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  name         String
  barcode      String?
  qty          Int      @default(1)
  unitBuyPrice Float @default(0)
  printedPrice Float @default(0)
  receivedQty  Int?
  status       String   @default("PENDING") // PENDING | OK | MISSING | REJECTED
  expiryDate   String?
  note         String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============ RETURNS ============

model ReturnRequest {
  id                String    @id @default(cuid())
  code              String    @unique // HZ-050723-0001
  customerName      String?
  customerPhone     String?
  customerCardNumber String?
  purchaseAt        String? // Jalali
  reason            String?
  note              String?
  totalAmount Float @default(0)
  exchangeValue Float @default(0)
  transferAmount Float @default(0)
  transferNote      String?
  settlementType    String    @default("exchange") // exchange | transfer | both
  status            String    @default("draft") // draft | pending | approved | paid
  cashierId         String?
  approvedById      String?
  approvedAt        DateTime?
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items ReturnItem[]
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  name      String
  barcode   String?
  qty       Int     @default(1)
  unit      String  @default("عدد")
  unitPrice Float @default(0)
  lineTotal Float @default(0)

  ret ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model ReturnPayment {
  id        String   @id @default(cuid())
  returnId  String
  kind      String // TRANSFER | ...
  amount    Int
  note      String?
  createdAt DateTime @default(now())
}

// ============ CRM ============

model Customer {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  returnsCount Int      @default(0)
  totalAmount Float @default(0)
  firstAt      DateTime @default(now())
  lastVisitAt  DateTime @default(now())
  smsEnabled   Boolean  @default(true)
  birthday     String? // Jalali
  note         String?
  manualTier   String? // VIP | LOYAL | REGULAR | NEW | AT_RISK | DORMANT
}

model Campaign {
  id        String   @id @default(cuid())
  title     String
  kind      String   @default("WINBACK") // WINBACK | BIRTHDAY | SEASONAL | ...
  targetTier String?
  date      String? // Jalali
  status    String   @default("DRAFT") // DRAFT | SENT
  createdAt DateTime @default(now())
}

model CrmEvent {
  id         String   @id @default(cuid())
  customerId String?
  kind       String // sms | note | call | visit
  content    String
  userId     String?
  createdAt  DateTime @default(now())
}

// ============ FINANCE ============

model Cheque {
  id          String   @id @default(cuid())
  number      String
  amount Float @default(0)
  status      String   @default("PENDING_OWNER") // PENDING_OWNER | WRITTEN | SIGNED | READY | COLLECTED | DONE | REJECTED | UNCOLLECTED
  recipient   String?
  sayadSerial String?
  selfIssued  Boolean  @default(false)
  writtenAt   String? // Jalali
  dueDate     String // Jalali
  note        String?
  orderCode   String?
  historyJson String   @default("[]") // [{at, by, action, detail}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  kind          String // CASH | POS | TRANSFER
  amount Float @default(0)
  supplierName  String?
  orderCode     String?
  note          String?
  holooReceiptNo String?
  createdById   String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

// ============ MARGIN (سودسنج) ============

model MarginInvoice {
  id           String    @id @default(cuid())
  number       Int       @default(1)
  supplierId   String?
  supplierName String?
  note         String?
  status       String    @default("draft") // draft | final
  archived     Boolean   @default(false)
  archivedAt   DateTime?
  dateJalali   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items MarginItem[]
}

model MarginItem {
  id           String  @id @default(cuid())
  invoiceId    String
  productId    String?
  barcode      String?
  productName  String
  unit         String  @default("عدد")
  quantity     Int     @default(1)
  totalCost Float @default(0)
  unitCost Float @default(0)
  printedPrice Float @default(0)
  margin       Float   @default(0)
  profitPerUnit Float @default(0)
  note         String?
  level        String  @default("OK") // OK | WARN | CRITICAL
  alertsJson   String  @default("[]")

  invoice MarginInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ============ HR ============

model Personnel {
  id             String   @id @default(cuid())
  userId         String   @unique
  fullName       String
  nationalId     String?
  phone          String?
  jobTitle       String?
  department     String?
  hireDate       String? // Jalali
  birthday       String? // Jalali
  bankCard       String?
  shaba          String?
  emergencyName  String?
  emergencyPhone String?
  note           String?
  active         Boolean  @default(true)
}

model SalaryProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  baseSalary Float @default(0)
  housingAllowance Float @default(0)
  foodAllowance Float @default(0)
  childAllowance Float @default(0)
  children        Int      @default(0)
  seniorityDaily Float @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  userId    String
  date      String // Jalali
  shift     String // MORNING | EVENING | NIGHT | OFF
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model LeaveRequest {
  id           String   @id @default(cuid())
  userId       String
  type         String // HOURLY | DAILY | SICK | UNPAID
  fromDate     String // Jalali
  toDate       String // Jalali
  days         Int      @default(1)
  hours        Int      @default(0)
  reason       String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  responseNote String?
  approverId   String?
  approverName String?
  createdAt    DateTime @default(now())
}

model PayrollRecord {
  id              String   @id @default(cuid())
  userId          String
  year            Int
  month           Int
  overtimeMinutes Int      @default(0)
  absenceDays     Int      @default(0)
  adjustment Float @default(0)
  savedJson       String   @default("{}") // {gross, insurance, tax, net, ...}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, year, month])
}

// ============ STORE ============

model Floorplan {
  id     String @id @default(cuid())
  name   String
  width  Int    @default(2560)
  height Int    @default(1200)

  blocks FloorBlock[]
}

model FloorBlock {
  id       String  @id @default(cuid())
  planId   String
  kind     String // ENTRANCE | EXIT | CHECKOUT | SHELF | WALL | COOLER | ...
  x        Int
  y        Int
  w        Int
  h        Int
  rotation Int     @default(0)
  label    String?
  zoneName String?
  metaJson String? // {responsible, ...}

  plan Floorplan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Planogram {
  id         String   @id @default(cuid())
  name       String
  blockLabel String?
  rows       Int      @default(4)
  cols       Int      @default(6)
  cellsJson  String   @default("[]") // flat array rows*cols of productId|null
  status     String   @default("DRAFT") // DRAFT | PUBLISHED | DONE | ARCHIVE
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Zone {
  id            String  @id @default(cuid())
  name          String
  type          String  @default("SALES") // SALES | BACKROOM | COLD | ...
  criticality   String  @default("C") // A | B | C
  countFrequency String @default("MONTHLY") // DAILY | WEEKLY | MONTHLY
  ownerName     String?
  minStaff      Int?
}

model ZoneCount {
  id           String   @id @default(cuid())
  date         String // Jalali
  zoneId       String
  zoneName     String
  userId       String?
  userName     String?
  itemsJson    String   @default("[]") // [{name|barcode, expected, counted}]
  status       String   @default("open") // open | done
  mismatchCount Int     @default(0)
  totalItems   Int      @default(0)
  tolerance    Float    @default(0)
  recheckCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PriceCheck {
  id        String   @id @default(cuid())
  date      String // Jalali
  productId String
  userId    String?
  lastCost  Int      @default(0)
  sellPrice Float @default(0)
  margin    Float    @default(0)
  ok        Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
}

model WasteRecord {
  id        String   @id @default(cuid())
  date      String // Jalali
  name      String
  qty       Int      @default(1)
  unit      String   @default("عدد")
  reason    String // EXPIRED | DAMAGED | LOST | ...
  estValue Float @default(0)
  userId    String?
  userName  String?
  note      String?
  createdAt DateTime @default(now())
}

// ============ SETTINGS ============

model Setting {
  key   String @id
  value String // JSON
}
