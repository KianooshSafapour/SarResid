/// برنامه پرداخت‌ها روی تقویم (چک/POS/نقد)
model PaymentPlan {
  id           String   @id @default(cuid())
  date         String // Jalali
  kind         String   @default("CHEQUE") // CHEQUE | POS | CASH
  amount       Float    @default(0)
  status       String   @default("PLANNED") // PLANNED | CONFIRMED | DONE
