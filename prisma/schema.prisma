  sentAt    DateTime?
}

/// پنل‌های پیامک — پیکربندی چند سرویس‌دهنده ایرانی + پنل سفارشی (R4-5)
model SmsPanel {
  id           String    @id @default(cuid())
  name         String
  provider     String // melipayamak|farazsms|payamresan|webone|niksms|payamito|smsir|farapayamak|custom
  mode         String    @default("mock") // mock | real
  settingsJson String    @default("{}") // provider-specific credentials + sender
  active       Boolean   @default(true)
  isDefault    Boolean   @default(false)
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  note         String    @default("")
  createdAt    DateTime  @default(now())
}

/// قالب پیامک — متن آماده با جای‌نگرد {name} {amount} {code} {date} (R4-5)
model SmsTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // PAYMENT_SUBMITTED | RETURN_PAYMENT | STAFF_BROADCAST | LOW_STOCK | ...
  title     String
  body      String // {name} {amount} {code} {date} placeholders
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

